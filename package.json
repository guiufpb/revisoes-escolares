{
  "name": "revisoes-escolares",
  "private": true,
  "scripts": {
    "build": "vite build && vite build --config vite.pdfjs.config.js",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "gerar:pdf": "node scripts/gerar_pdf.js",
    "gerar:previews": "node scripts/gerar_previews.js",
    "validar:cartilha": "node scripts/validar_cartilha.js",
    "preparar:pdfs-teste": "node scripts/preparar-pdfs-teste.cjs",
    "interativo": "vite --host 127.0.0.1 --port 5173 --strictPort --open /ambiente_interativo/index.html",
    "format": "prettier --write \"ambiente_interativo/**/*.{html,css,js}\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"ambiente_interativo/**/*.{html,css,js}\" \"tests/**/*.js\" \"scripts/validacao/**/*.cjs\" \"tests/validacao/**/*.cjs\" \"validacao/*.json\" \"playwright.config.js\" \"eslint.config.js\" \"package.json\" \".github/workflows/validacao.yml\" \"validacao/*.md\"",
    "lint": "eslint ambiente_interativo/**/*.js tests/**/*.js \"scripts/validacao/**/*.cjs\" \"tests/validacao/**/*.cjs\" playwright.config.js",
    "pronuncia:gateway": "node scripts/azure-pronunciation-gateway.js",
    "pretest:interativo": "npm run build",
    "test:interativo": "playwright test tests/ambiente-interativo.spec.js",
    "pretest:a11y": "npm run build",
    "test:a11y": "playwright test tests/acessibilidade.spec.js",
    "pretest:e2e": "npm run validar:manifesto && npm run test:validacao && npm run build && node scripts/validacao/ci-observacional.cjs planejar",
    "test:e2e": "playwright test",
    "test": "npm run test:e2e",
    "validar:manifesto": "node scripts/validacao/manifesto.cjs",
    "test:validacao": "node --test tests/validacao/*.unit.cjs",
    "planejar:testes": "node scripts/validacao/planejador-cli.cjs plano",
    "test:planejador": "node --test tests/validacao/planejador.unit.cjs",
    "comparar:plano": "node scripts/validacao/planejador-cli.cjs comparar"
  },
  "dependencies": {
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/openmoji": "^1.2.29",
    "@iconify-json/twemoji": "^1.2.5",
    "@iconify/utils": "^3.1.7",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "acorn": "8.19.0",
    "ajv": "8.20.0",
    "eslint": "^10.12.0",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.4"
  }
}
