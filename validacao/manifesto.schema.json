{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "basis",
    "evidenceCatalog",
    "revisions",
    "engines",
    "capabilities",
    "contracts",
    "tests",
    "keyExceptions",
    "gaps",
    "discovery"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{40}$"
        },
        "tree": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "evidenceCatalog": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "url", "version", "scope"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https://github.com/guiufpb/revisoes-escolares/"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "revisions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/revision"
      }
    },
    "engines": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/entity"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/entity"
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "representatives", "limits"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "representatives": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "pattern"],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "pattern": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/test"
      }
    },
    "keyExceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "revisions", "reason", "evidence"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "revisions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "$ref": "#/definitions/evidence"
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "blocksCompleteness"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "blocksCompleteness": {
            "const": true
          }
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileCount", "caseCount"],
      "properties": {
        "fileCount": {
          "type": "integer",
          "minimum": 1
        },
        "caseCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "definitions": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "anchor"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "oracle", "journeyScope", "limitations"],
      "properties": {
        "coverage": {
          "type": "array",
          "items": {
            "enum": [
              "declarative",
              "behavioral-contract",
              "complete-journey",
              "partial-journey",
              "prepared-state",
              "administrative-navigation",
              "visual-accessibility"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "oracle": {
          "enum": ["independent", "application", "mixed", "not-applicable"]
        },
        "journeyScope": {
          "enum": ["contract", "questions", "block", "prepared-state", "administrative"]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "revisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "kind", "evidence"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": ["import-order", "global-call", "global-alias", "own-audio"]
        },
        "evidence": {
          "$ref": "#/definitions/evidence"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sources", "consumers", "dependencies", "contracts", "limits"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dependency"
          }
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "subject",
        "declaredEngine",
        "engine",
        "primaryKey",
        "configFiles",
        "contentSources",
        "capabilities",
        "sessions",
        "contentDependencies",
        "historicalKeys",
        "assets",
        "tests",
        "evidence",
        "evidenceAvailable",
        "gaps",
        "maturity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(alice|mariana)-(ciencias|geografia|historia|gramatica|matematica|ingles|leitura)-[a-z0-9-]+$"
        },
        "profile": {
          "enum": ["alice", "mariana"]
        },
        "subject": {
          "enum": [
            "ciencias",
            "geografia",
            "historia",
            "gramatica",
            "matematica",
            "ingles",
            "leitura"
          ]
        },
        "declaredEngine": {
          "type": ["string", "null"]
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "primaryKey": {
          "type": "string",
          "minLength": 1
        },
        "configFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "contentSources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "key", "principal"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "principal": {
                "type": "boolean"
              }
            }
          }
        },
        "contentDependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["revision", "kind", "evidence"],
            "properties": {
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": ["runtime-registry-copy", "shared-content"]
              },
              "evidence": {
                "$ref": "#/definitions/evidence"
              }
            }
          }
        },
        "historicalKeys": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "reason"],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence"
          }
        },
        "evidenceAvailable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "maturity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assessment", "historicalCollection", "futureCandidate"],
          "properties": {
            "assessment": {
              "const": "not-evaluated"
            },
            "historicalCollection": {
              "const": "not-configured"
            },
            "futureCandidate": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "revisions",
        "engines",
        "capabilities",
        "contracts",
        "platforms",
        "fixtures",
        "defaults",
        "cases",
        "gaps",
        "expectedCases"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "revisions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "engines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "platforms": {
          "type": "array",
          "items": {
            "enum": ["windows", "linux"]
          },
          "uniqueItems": true
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "defaults": {
          "$ref": "#/definitions/metadata"
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "pattern", "expectedMatches", "metadata"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "expectedMatches": {
                "type": "integer",
                "minimum": 1
              },
              "metadata": {
                "$ref": "#/definitions/metadata"
              }
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "expectedCases": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
