{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Worktree lifecycle record v1 (private declarations)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "worktreeId",
    "recordedAt",
    "location",
    "purpose",
    "task",
    "phase",
    "declaredState",
    "observations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "worktreeId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
      "maxLength": 20
    },
    "location": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "purpose": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "task": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "phase": {
      "anyOf": [
        {
          "enum": ["planning", "implementation", "validation", "delivery", "integration", "closed"]
        },
        {
          "type": "null"
        }
      ]
    },
    "declaredState": {
      "anyOf": [
        {
          "enum": ["active", "paused", "completed"]
        },
        {
          "type": "null"
        }
      ]
    },
    "observations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "topic", "text", "recordedAt", "supersedes"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
          },
          "topic": {
            "enum": [
              "purpose",
              "task",
              "phase",
              "declaredState",
              "location",
              "dependency",
              "history",
              "general"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
            "maxLength": 20
          },
          "supersedes": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "target", "reason"],
            "properties": {
              "kind": {
                "const": "worktree"
              },
              "target": {
                "type": "string",
                "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "target", "reason"],
            "properties": {
              "kind": {
                "const": "resource"
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              }
            }
          }
        ]
      }
    },
    "history": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "reference", "note"],
        "properties": {
          "kind": {
            "enum": ["commit", "pull-request", "local-evidence"]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        }
      }
    }
  }
}
